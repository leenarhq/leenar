# Leenar open-core self-host — environment for `docker compose up`.
#
# This file mirrors docker/.env.example — the copy `docker/setup.sh` actually
# reads and writes to a repo-root `.env` (next to docker-compose.yml, fills
# the random secrets below automatically). See SELF-HOST.md for the full
# quick-start.

# Required: this is what powers chat→canvas (the product calls gpt-4o).
OPENAI_API_KEY=

# Filled in by setup.sh — leave these blank:
ENCRYPTION_KEY=
INTERNAL_SECRET=
STATE_SIGNING_SECRET=
REALTIME_SECRET_KEY_BASE=

# First account: a Leenar user is created with these credentials the first time
# the stack boots, so there is no browser signup step. setup.sh generates the
# password. Clear both and no account is created — sign up by hand at
# http://localhost:8080/signup instead. Changing the password here AFTER the
# first boot does not reset the account (so a password you changed from inside
# the app is never overwritten); SELF-HOST.md has the reset procedure.
LEENAR_ADMIN_EMAIL=admin@leenar.local
LEENAR_ADMIN_PASSWORD=

# Fixed demo values — do not change them, they are baked into the web build.
# The anon/service_role keys are self-minted from this JWT secret and are valid
# for the local demo stack only. Rotate all three before exposing this stack to
# anyone else — see the production warning in SELF-HOST.md.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE3MzU2ODk2MDAsImV4cCI6MjA1MTIyMjQwMH0.Qmr2WrE1NwBbJGY1FYQqGyToK2PADvELplvZSzWXgRk
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTczNTY4OTYwMCwiZXhwIjoyMDUxMjIyNDAwfQ.TuKhFKKIALxemkRdMeiBGFSP0A1bQ6tIarwOgghCgH4
