# Leenar open-core self-host — environment for `docker compose up`.
#
# This file mirrors docker/.env.example — the copy `docker/setup.sh` actually
# reads and writes to a repo-root `.env` (next to docker-compose.yml, fills
# the random secrets below automatically). See SELF-HOST.md for the full
# quick-start.

# Zorunlu: chat→canvas için (ürün gpt-4o kullanıyor)
OPENAI_API_KEY=

# setup.sh tarafından doldurulur (elle DOKUNMA):
ENCRYPTION_KEY=
INTERNAL_SECRET=
STATE_SIGNING_SECRET=
REALTIME_SECRET_KEY_BASE=

# İlk hesap: stack ilk kez ayağa kalkarken bu kimlik bilgileriyle bir Leenar
# kullanıcısı oluşturulur, yani tarayıcıdan signup yapmaya gerek kalmaz.
# Şifreyi setup.sh üretir. İkisini birden boşaltırsan hiçbir hesap
# oluşturulmaz — http://localhost:8080/signup üzerinden elle açarsın.
# İlk açılıştan SONRA buradaki şifreyi değiştirmek hesabı sıfırlamaz
# (uygulamadan değiştirdiğin şifreyi ezmemek için); reset yolu SELF-HOST.md'de.
LEENAR_ADMIN_EMAIL=admin@leenar.local
LEENAR_ADMIN_PASSWORD=

# Sabit demo (değiştirme — web build'e gömülü). Bu JWT secret ile self-mint
# edilmiş anon/service_role key'leri; sadece local demo stack'i için geçerli.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE3MzU2ODk2MDAsImV4cCI6MjA1MTIyMjQwMH0.Qmr2WrE1NwBbJGY1FYQqGyToK2PADvELplvZSzWXgRk
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTczNTY4OTYwMCwiZXhwIjoyMDUxMjIyNDAwfQ.TuKhFKKIALxemkRdMeiBGFSP0A1bQ6tIarwOgghCgH4
