# This file lives at docker/Dockerfile.api and is built with the repo root as
# build context — see the root docker-compose.yml `api` service
# (context: ., dockerfile: docker/Dockerfile.api). Every COPY path below is
# therefore relative to the repo root, not to docker/.

# ---- build stage: bundle the worker ----
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY workers/api/ ./workers/api/
COPY supabase/ ./supabase/
WORKDIR /app/workers/api
# Only workers/api/ is copied into this build context — no workspace root and no
# lockfile — so npm re-resolves from scratch instead of replaying the monorepo's
# lockfile, and that resolution has to hold up on its own. It used to need
# --legacy-peer-deps: workers/api pinned wrangler@^3 while @sentry/cloudflare's
# peerOptional asked for ^4, and npm 7+ hard-fails on that. Those agree now, so
# peer enforcement stays on — a future conflict should fail this image build
# rather than be waived unnoticed.
RUN npm install
RUN npx wrangler deploy --dry-run --outdir=dist

# ---- runtime stage: workerd ----
FROM node:24-bookworm-slim
WORKDIR /app
# ca-certificates is REQUIRED: node:24-bookworm-slim ships an EMPTY
# /etc/ssl/certs. The build stage masks this, because npm/node use their own
# bundled CA set — workerd does not, it reads the system one. Without this,
# `trustBrowserCas = true` in api.capnp finds no root to trust and every
# outbound HTTPS call dies with `certificate is not trusted; unable to get
# local issuer certificate` (the OpenAI call 500s, chat→canvas never works).
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g workerd@1.20260804.1
COPY --from=build /app/workers/api/dist/ ./dist/
COPY docker/api.capnp ./api.capnp
RUN mkdir -p do-state
EXPOSE 8787
CMD ["workerd", "serve", "api.capnp"]
